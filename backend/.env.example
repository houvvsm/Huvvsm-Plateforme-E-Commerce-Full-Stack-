# HUVVSM V2 — Server Configuration Example
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL/Prisma)
DATABASE_URL="postgresql://username:password@hostname:port/database?sslmode=require"

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here

# AI Integration API Keys (Grok / Gemini)
# The system tries Grok first, and falls back to Gemini if XAI_API_KEY is not set.
XAI_API_KEY=xai-your-grok-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Email Notification Server (Nodemailer SMTP config)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
SUPPORT_EMAIL=your-support-email@gmail.com
